{
  "appId": "app.orby.mobile",
  "appName": "Orby",
  "webDir": "public",
  "android": {
    "path": "mobile-android"
  },
  "server": {
    "url": "https://orby.shardweb.app",
    "cleartext": false,
    "allowNavigation": [
      "orby.shardweb.app",
      "orbyapp.discloud.dev",
      "orbyapp.discloud.app",
      "orbyfinance.discloud.dev"
    ]
  },
  "plugins": {
    "LocalNotifications": {
      "smallIcon": "orby_logo",
      "iconColor": "#3598F5"
    },
    "PushNotifications": {
      "presentationOptions": ["alert", "sound"]
    }
  }
}
